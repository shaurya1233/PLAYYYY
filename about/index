  <style>
    :root {
      color-scheme: dark;
      --bg: #0b0d0c;
      --surface: #111512;
      --surface-2: #171d19;
      --text: #f1f0e9;
      --muted: #a4aaa1;
      --soft: #777f76;
      --accent: #d2a96c;
      --accent-bright: #f0cb91;
      --line: rgba(222, 204, 168, .17);
      --serif: Georgia, "Times New Roman", serif;
      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
      --max: 1160px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-width: 320px;
      background:
        radial-gradient(ellipse at 82% 10%, rgba(111, 128, 91, .13), transparent 34rem),
        radial-gradient(ellipse at 6% 55%, rgba(178, 126, 65, .08), transparent 31rem),
        var(--bg);
      color: var(--text);
      font-family: var(--sans);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    a { color: inherit; }
    a:focus-visible {
      outline: 2px solid var(--accent-bright);
      outline-offset: 5px;
    }

    .wrap {
      width: min(var(--max), calc(100% - 48px));
      margin-inline: auto;
    }

    .topbar {
      border-bottom: 1px solid var(--line);
      background: rgba(11, 13, 12, .76);
    }

    .nav {
      min-height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--text);
      text-decoration: none;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .28em;
    }

    .brand-mark {
      width: 31px;
      height: 31px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(210, 169, 108, .6);
      color: var(--accent-bright);
      font-family: var(--serif);
      font-size: 18px;
      font-weight: 400;
      letter-spacing: 0;
      transform: rotate(-3deg);
    }

    .nav-link {
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .14em;
      text-decoration: none;
      text-transform: uppercase;
      transition: color .2s ease;
    }

    .nav-link:hover { color: var(--accent-bright); }

    main { overflow: hidden; }

    .hero {
      min-height: 680px;
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(290px, .72fr);
      align-items: center;
      gap: clamp(48px, 8vw, 112px);
      padding-block: 88px 104px;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 27px;
      color: var(--accent);
      font: 11px/1.4 var(--mono);
      letter-spacing: .22em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 34px;
      height: 1px;
      background: var(--accent);
    }

    h1, h2, p { margin-top: 0; }

    h1 {
      max-width: 760px;
      margin-bottom: 27px;
      font: 400 clamp(3.6rem, 8.1vw, 7.4rem)/.98 var(--serif);
      letter-spacing: -.065em;
    }

    h1 em {
      color: var(--accent-bright);
      font-weight: 400;
    }

    .intro {
      max-width: 610px;
      margin-bottom: 35px;
      color: #c0c4bc;
      font-size: clamp(16px, 1.55vw, 19px);
      line-height: 1.85;
    }

    .intro strong {
      color: var(--text);
      font-weight: 600;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 23px;
    }

    .button {
      min-height: 49px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
      border: 1px solid rgba(210, 169, 108, .62);
      background: linear-gradient(135deg, rgba(210, 169, 108, .15), rgba(210, 169, 108, .04));
      color: var(--accent-bright);
      font: 11px var(--mono);
      letter-spacing: .13em;
      text-decoration: none;
      text-transform: uppercase;
      transition: background .2s ease, transform .2s ease, border-color .2s ease;
    }

    .button:hover {
      background: rgba(210, 169, 108, .2);
      border-color: var(--accent-bright);
      transform: translateY(-2px);
    }

    .text-link {
      color: var(--muted);
      font: 11px var(--mono);
      letter-spacing: .12em;
      text-decoration: none;
      text-transform: uppercase;
    }

    .text-link:hover { color: var(--text); }

    .portrait-column {
      position: relative;
      width: min(100%, 390px);
      justify-self: end;
    }

    .portrait-frame {
      position: relative;
      padding: 12px;
      border: 1px solid rgba(210, 169, 108, .32);
      background: linear-gradient(145deg, rgba(210, 169, 108, .12), rgba(255,255,255,.015) 42%, rgba(110, 132, 102, .09));
    }

    .portrait-frame::before,
    .portrait-frame::after {
      position: absolute;
      z-index: 2;
      width: 38px;
      height: 38px;
      content: "";
      pointer-events: none;
    }

    .portrait-frame::before {
      top: -7px;
      left: -7px;
      border-top: 1px solid var(--accent-bright);
      border-left: 1px solid var(--accent-bright);
    }

    .portrait-frame::after {
      right: -7px;
      bottom: -7px;
      border-right: 1px solid var(--accent-bright);
      border-bottom: 1px solid var(--accent-bright);
    }

    .portrait {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      object-position: center;
      background: #1a201b;
    }

    .image-caption {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding: 14px 2px 0;
      color: var(--soft);
      font: 10px var(--mono);
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .image-caption span:last-child { color: var(--accent); }

    .divider {
      height: 1px;
      background: var(--line);
    }

    .details {
      display: grid;
      grid-template-columns: .72fr 1.28fr;
      gap: clamp(35px, 8vw, 115px);
      padding-block: 76px 90px;
    }

    .section-label {
      margin: 7px 0 0;
      color: var(--accent);
      font: 11px var(--mono);
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .details h2 {
      margin-bottom: 20px;
      font: 400 clamp(2.1rem, 4.2vw, 3.65rem)/1.08 var(--serif);
      letter-spacing: -.045em;
    }

    .details-copy {
      max-width: 690px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.9;
    }

    .details-copy p:last-child { margin-bottom: 0; }

    .focus-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      margin-top: 30px;
      border: 1px solid var(--line);
      background: var(--line);
    }

    .focus-item {
      min-height: 104px;
      padding: 20px 22px;
      background: var(--surface);
    }

    .focus-item small {
      display: block;
      margin-bottom: 9px;
      color: var(--accent);
      font: 10px var(--mono);
      letter-spacing: .12em;
    }

    .focus-item span {
      color: var(--text);
      font: 17px var(--serif);
    }

    footer { border-top: 1px solid var(--line); }

    .footer-inner {
      min-height: 94px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      color: var(--soft);
      font: 10px var(--mono);
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .footer-inner a {
      color: var(--muted);
      text-decoration: none;
    }

    .footer-inner a:hover { color: var(--accent-bright); }

    @media (max-width: 800px) {
      .hero {
        min-height: auto;
        grid-template-columns: 1fr;
        gap: 54px;
        padding-block: 75px 78px;
      }

      .portrait-column {
        width: min(78%, 390px);
        justify-self: start;
        margin-left: 8px;
      }

      .details {
        grid-template-columns: 1fr;
        gap: 22px;
        padding-block: 60px 70px;
      }
    }

    @media (max-width: 520px) {
      .wrap { width: min(var(--max), calc(100% - 34px)); }
      .nav { min-height: 70px; }

      h1 { font-size: clamp(3.45rem, 17vw, 5.2rem); }

      .hero { padding-block: 59px 66px; }

      .portrait-column { width: min(91%, 360px); }

      .focus-grid { grid-template-columns: 1fr; }

      .footer-inner {
        min-height: 84px;
        align-items: flex-start;
        justify-content: center;
        flex-direction: column;
        gap: 7px;
        padding-block: 18px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }

      *, *::before, *::after {
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="wrap nav">
